# ─────────────────────────────────────────────────────────────
# Portal SpFc/Gd — Variables de entorno de Supabase
# Copia este archivo a `.env` y completa los valores.
# ─────────────────────────────────────────────────────────────

# URL del proyecto (Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" (segura para el cliente gracias a RLS)
VITE_SUPABASE_ANON_KEY=TU-CLAVE-ANON-PUBLICA
