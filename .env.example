# ─────────────────────────────────────────────────────────────
# Portal SpFc/Gd — Variables de entorno de Supabase
# Copia este archivo a `.env` y completa los valores.
# El `.env` NO se sube al repositorio (ver .gitignore): aquí solo van
# valores de ejemplo. Nunca pongas correos o contraseñas personales.
# ─────────────────────────────────────────────────────────────

# URL del proyecto (Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" (segura para el cliente gracias a RLS)
VITE_SUPABASE_ANON_KEY=TU-CLAVE-ANON-PUBLICA

# Clave pública de Web Push (también es pública, se usa en el frontend)
VITE_VAPID_PUBLIC_KEY=TU-VAPID-PUBLICO

# ─────────────────────────────────────────────────────────────
# Secrets de la Edge Function send-push (NO van en el frontend).
# Se configuran en Supabase → Edge Functions → Manage → Secrets:
#   VAPID_PUBLIC_KEY
#   VAPID_PRIVATE_KEY
#   VAPID_SUBJECT=mailto:no-reply@spfc.gd   (genérico, sin datos personales)
# ─────────────────────────────────────────────────────────────
